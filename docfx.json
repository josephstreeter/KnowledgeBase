{
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "files": [
          "styles/*.css"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default"
    ],
    "globalMetadata": {
      "_appName": "Madison College Knowledge Base",
      "_appTitle": "Madison College Knowledge Base",
      "_enableSearch": true,
      "pdf": true,
      "_favicon": "docs/knowledgebase/favicon.ico",
      "_logo": "docs/knowledgebase/logo.svg"
    }
  }
}